{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"Keycloak": {
		"BaseUrl": "http://localhost:8080",
		"Realm": "umbral",
		"Audience": "account"
	},
	"Cors": {
		"AllowedOrigins": ["http://localhost:3000"]
	},
	"ReverseProxy": {
		"Routes": {
			"users-admin": {
				"ClusterId": "usercluster",
				"Match": {
					"Path": "/api/users/{**catch-all}",
					"Methods": [ "GET", "POST", "DELETE" ]
				},
				"AuthorizationPolicy": "AdminOnly"
			},
			"users-update": {
				"ClusterId": "usercluster",
				"Match": {
					"Path": "/api/users/{id:guid}",
					"Methods": [ "PUT" ]
				},
				"AuthorizationPolicy": "Authenticated"
			},
			"missions": {
				"ClusterId": "missioncluster",
				"Match": {
					"Path": "/api/missions/{**catch-all}"
				},
				"AuthorizationPolicy": "AdminOrOperator"
			},
			"sessions-join": {
				"ClusterId": "livesessioncluster",
				"Match": {
					"Path": "/api/sessions/{id:guid}/teams/{teamId:guid}/join",
					"Methods": [ "POST" ]
				},
				"AuthorizationPolicy": "Authenticated",
				"Order": 1
			},
			"sessions-admin-operator": {
				"ClusterId": "livesessioncluster",
				"Match": {
					"Path": "/api/sessions/{**catch-all}",
					"Methods": [ "POST", "PATCH", "DELETE" ]
				},
				"AuthorizationPolicy": "AdminOrOperator",
				"Order": 2
			},
			"sessions-authenticated": {
				"ClusterId": "livesessioncluster",
				"Match": {
					"Path": "/api/sessions/{**catch-all}",
					"Methods": [ "GET" ]
				},
				"AuthorizationPolicy": "Authenticated",
				"Order": 2
			},
			"sessionhub": {
				"ClusterId": "livesessioncluster",
				"Match": {
					"Path": "/hubs/sessions/{**catch-all}"
				},
				"AuthorizationPolicy": "Authenticated"
			},
			"users-swagger": {
				"ClusterId": "usercluster",
				"Match": {
					"Path": "/swagger-users/{**catch-all}"
				},
				"Transforms": [
					{ "PathPattern": "/{**catch-all}" }
				]
			},
			"missions-swagger": {
				"ClusterId": "missioncluster",
				"Match": {
					"Path": "/swagger-missions/{**catch-all}"
				},
				"Transforms": [
					{ "PathPattern": "/{**catch-all}" }
				]
			},
			"sessions-swagger": {
				"ClusterId": "livesessioncluster",
				"Match": {
					"Path": "/swagger-sessions/{**catch-all}"
				},
				"Transforms": [
					{ "PathPattern": "/{**catch-all}" }
				]
			}
		},
		"Clusters": {
			"usercluster": {
				"Destinations": {
					"destination1": {
						"Address": "http://localhost:5020"
					}
				}
			},
			"missioncluster": {
				"Destinations": {
					"destination1": {
						"Address": "http://localhost:5022"
					}
				}
			},
			"livesessioncluster": {
				"Destinations": {
					"destination1": {
						"Address": "http://localhost:5026"
					}
				}
			}
		}
	}
}
