{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"Keycloak": {
		"BaseUrl": "http://localhost:8080",
		"Realm": "umbral",
		"Audience": "account"
	},
	"Cors": {
		"AllowedOrigins": ["http://localhost:3000"]
	},
	"UserService": {
		"BaseUrl": "http://localhost:5020"
	},
	"MissionService": {
		"BaseUrl": "http://localhost:5022"
	},
	"LiveSessionService": {
		"BaseUrl": "http://localhost:5026"
	},
	"ReverseProxy": {
		"Routes": {
			"sessionhub": {
				"ClusterId": "livesessioncluster",
				"Match": {
					"Path": "/hubs/sessions/{**catch-all}"
				}
			}
		},
		"Clusters": {
			"livesessioncluster": {
				"Destinations": {
					"destination1": {
						"Address": "http://localhost:5026"
					}
				}
			}
		}
	}
}
