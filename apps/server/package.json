{
	"name": "server",
	"private": true,
	"scripts": {
		"dev:api": "dotnet watch --project ./api/api.csproj",
		"dev:userService": "dotnet watch --project ./userService/userService.csproj",
		"dev:missionService": "dotnet watch --project ./missionService/missionService.csproj",
		"dev": "bun x concurrently -k -n api,userService,missionService \"bun run dev:api\" \"bun run dev:userService\" \"bun run dev:missionService\"",
		"build": "dotnet build ./server.slnx",
		"test": "dotnet test --settings coverlet.runsettings --collect:\"XPlat Code Coverage\"",
		"coverage:report": "reportgenerator -reports:\"./*.Tests/TestResults/*/coverage.cobertura.xml\" -targetdir:\"./coveragereport\" \"-reporttypes:TextSummary;Html\"",
		"test:coverage": "bun run test && bun run coverage:report",
		"start": "dotnet run --project ./api/api.csproj",
		"start:api": "dotnet run --project ./api/api.csproj",
		"start:userService": "dotnet run --project ./userService/userService.csproj",
		"start:missionService": "dotnet run --project ./missionService/missionService.csproj"
	}
}
