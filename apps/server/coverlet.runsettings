<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Excluir namespaces y ensamblados de pruebas y migraciones -->
          <Exclude>[*.Tests]*,[TestUtils]*,[*]*Migrations*,[*]*.Migrations*</Exclude>
          <!-- Excluir por atributos estándar de exclusión o autogenerados -->
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- Excluir archivos específicos como configuraciones de inicio y migraciones -->
          <ExcludeByFile>**/Migrations/*.cs,**/Program.cs,**/DependencyInjection.cs,**/*DbContextModelSnapshot.cs,**/*Configuration.cs,**/*DbContext.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
