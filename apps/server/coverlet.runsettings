<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[TestUtils]*,[*]*.Migrations.*,[*]*Migrations*,[*]System.Runtime.CompilerServices,[*]*Program*,[*]Microsoft.AspNetCore.OpenApi.Generated.*,[*]*DbContextModelSnapshot*,[*]*KeycloakInternalRedirectHandler*,[*]*EventBus*,[*]*Hub*,[*]*.DTOs.*,[*]*Request,[*]*Response</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
