{
  "dependencies": {
    "@umbral/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "catalog:",
    "@umbral/config": "workspace:*",
    "turbo": "^2.9.18",
    "typescript": "catalog:",
    "ultracite": "7.8.3"
  },
  "name": "umbral",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @umbral/db",
    "db:studio": "turbo run db:studio -F @umbral/db",
    "db:generate": "turbo run db:generate -F @umbral/db",
    "db:migrate": "turbo run db:migrate -F @umbral/db",
    "db:local": "turbo run db:local -F @umbral/db",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@microsoft/signalr": "^8.0.7",
      "@types/node": "^20.19.41",
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.5",
      "@tanstack/react-form": "^1.28.0",
      "@types/react-dom": "^19.2.3",
      "@types/bun": "^1.3.14",
      "typescript": "^6"
    }
  },
  "private": true,
  "packageManager": "bun@1.3.14"
}