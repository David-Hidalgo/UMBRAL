{
	"name": "umbral",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/node": "^20.19.41",
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"lucide-react": "^0.546.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.5",
			"@tanstack/react-form": "^1.28.0",
			"@types/react-dom": "^19.2.3",
			"@types/bun": "^1.3.14",
			"typescript": "^6"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"db:push": "turbo -F @umbral/db db:push",
		"db:studio": "turbo -F @umbral/db db:studio",
		"db:generate": "turbo -F @umbral/db db:generate",
		"db:migrate": "turbo -F @umbral/db db:migrate",
		"db:local": "turbo -F @umbral/db db:local",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@umbral/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@umbral/config": "workspace:*",
		"turbo": "^2.8.12",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
