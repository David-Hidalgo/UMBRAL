{
  "name": "UMBRAL",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.5",
      "@prisma/client": "^7.2.0",
      "better-auth": "1.5.5",
      "@tanstack/react-form": "^1.28.0",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "@better-auth/expo": "1.5.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @UMBRAL/db db:push",
    "db:studio": "turbo -F @UMBRAL/db db:studio",
    "db:generate": "turbo -F @UMBRAL/db db:generate",
    "db:migrate": "turbo -F @UMBRAL/db db:migrate",
    "db:start": "turbo -F @UMBRAL/db db:start",
    "db:watch": "turbo -F @UMBRAL/db db:watch",
    "db:stop": "turbo -F @UMBRAL/db db:stop",
    "db:down": "turbo -F @UMBRAL/db db:down"
  },
  "dependencies": {
    "@UMBRAL/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@UMBRAL/config": "workspace:*",
    "@types/node": "^22.13.14",
    "turbo": "^2.8.12",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.11"
}
