# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=change-me

# Postgres
POSTGRES_DB=umbral_db
POSTGRES_USER=umbral_db_user
POSTGRES_PASSWORD=change-me

# Keycloak
SERVICE_URL_KEYCLOAK=http://localhost:8080
KEYCLOAK_ADMIN_CLIENT_ID=user-service-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Cuenta de servicio del scoringService (client credentials): lee el contenido de
# misiones sin el token del jugador. Requiere un cliente confidencial 'scoring-service'
# en el realm umbral con "Service accounts" habilitado y el rol de realm 'operator'.
# Ver apps/server/scoringService/README.md para el setup.
SCORING_SERVICE_CLIENT_ID=scoring-service
SCORING_SERVICE_CLIENT_SECRET=change-me

# CORS — orígenes permitidos (agregar más con _2, _3, etc.)
CORS_ALLOWED_ORIGIN_0=http://localhost:3000
CORS_ALLOWED_ORIGIN_1=http://localhost:8081
