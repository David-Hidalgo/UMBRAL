# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=change-me

# Postgres
POSTGRES_DB=umbral_db
POSTGRES_USER=umbral_db_user
POSTGRES_PASSWORD=change-me

# Keycloak
# En emulador Android o dispositivo físico usar la IP de la PC (ej: http://192.168.0.222:8080)
# En desarrollo local desde el navegador usar http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_CLIENT_ID=user-service-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:3000
